# Bambuddy runs on host network as PORT=8013 on this machine.
BAMBUDDY_URL=http://127.0.0.1:8013
BAMBUDDY_API_KEY=replace-with-bambuddy-api-key
H2C_PRINTER_ID=
H2C_SERIAL=replace-with-h2c-serial
H2C_NAME=H2C

# Mosquitto (mqtt5 container) is published on host :1883
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

BAMBUDDY_TOPIC_PREFIX=bambuddy
DISPLAY_TOPIC_PREFIX=display/h2c
POLL_SECONDS=30

AMS2PRO_COUNT=4
AMSHT_COUNT=2
AMSHT_MAX=4
