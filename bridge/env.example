# Data source: auto selects direct when DIRECT_PRINTER_HOST is set, otherwise Bambuddy.
# Explicit values: auto, bambuddy, direct
DATA_SOURCE=auto

# Bambuddy mode (not needed when using direct mode).
BAMBUDDY_URL=http://127.0.0.1:8013
BAMBUDDY_API_KEY=replace-with-bambuddy-api-key
H2C_PRINTER_ID=
H2C_SERIAL=replace-with-h2c-serial
H2C_NAME=H2C

# Direct mode: reads the printer and attached AMS units without FilaMan or Bambuddy.
# Enable LAN Only mode on the printer. Developer Mode is required only for controls.
DIRECT_PRINTER_HOST=
DIRECT_PRINTER_PORT=8883
# May be left empty when H2C_SERIAL above is set.
DIRECT_PRINTER_SERIAL=
DIRECT_PRINTER_ACCESS_CODE=

# Mosquitto (mqtt5 container) is published on host :1883
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Set true only when the broker certificate is self-signed.
MQTT_TLS_INSECURE=false

BAMBUDDY_TOPIC_PREFIX=bambuddy
DISPLAY_TOPIC_PREFIX=display/amsview
POLL_SECONDS=60
# Republish after a live source status message, but not more often than this.
LIVE_COALESCE_SECONDS=5

# Aggregated snapshot for the panel (poll instead of many MQTT topics).
# GET http://<bridge-host>:8090/display/amsview/state
DISPLAY_HTTP_ENABLED=true
DISPLAY_HTTP_HOST=0.0.0.0
DISPLAY_HTTP_PORT=8090

# AMS 2 Pro units keep printer ids 0-3. Connected AMS-HT units follow as HT1, HT2, ...
AMS2PRO_COUNT=4
