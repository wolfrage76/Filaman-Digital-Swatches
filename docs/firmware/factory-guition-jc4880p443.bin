␀␀␀Update was aborted␀␀No printers reported yet. Check the FilaMan URL and API key on the Data tab.␀␀␀␀Waiting for printer discovery payload over MQTT...␀␀Active␀␀Standby␀AP / Offline␀␀␀␀MQTT Mode␀␀␀<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Digital Swatch System В· Console</title><style>:root{--bg:#070a0f;--bg-elev:#0d131c;--card:#111823;--card-2:#151f2d;--border:#222f42;--border-soft:#1a2433;--text:#eef2f7;--muted:#8a99ad;--dim:#59687b;--accent:#3ddc97;--accent-hover:#54e6a6;--accent-soft:rgba(61,220,151,.12);--info:#5aa7ff;--warn:#ffb443;--danger:#ff5c6a;--radius:12px;--mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}*{box-sizing:border-box}body{margin:0;padding:0;background:radial-gradient(ellipse 90% 45% at 50% -10%,rgba(61,220,151,.10),transparent 70%),var(--bg);color:var(--text);font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}.shell{max-width:1020px;margin:0 auto;padding:24px 18px 56px}.topbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px;background:rgba(17,24,35,.88);border:1px solid var(--border);border-radius:14px;box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 14px 34px rgba(0,0,0,.35);margin-bottom:18px}.brand{display:flex;align-items:center;gap:14px}.swatch-mark{display:grid;grid-template-columns:repeat(4,6px);gap:3px;padding:7px;background:#0a0f16;border:1px solid var(--border);border-radius:10px;height:40px;align-items:stretch}.swatch-mark span{display:block;border-radius:2px}.sm-1{background:#3ddc97}.sm-2{background:#5aa7ff}.sm-3{background:#ffb443}.sm-4{background:#ff5c6a}.brand-title{margin:0;font-size:18px;font-weight:700;letter-spacing:-.02em;color:var(--text)}.brand-sub{margin:2px 0 0;font-size:12px;color:var(--muted)}.telemetry{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.chip{display:inline-flex;align-items:center;gap:7px;padding:5px 11px;background:var(--bg-elev);border:1px solid var(--border);border-radius:999px;font-size:12px;color:var(--muted);font-family:var(--mono);font-variant-numeric:tabular-nums}.chip strong{color:var(--text);font-weight:600}.dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}.dot-warn{background:var(--warn);box-shadow:0 0 8px var(--warn)}.tabs{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 22px;padding:5px;background:#0b1017;border:1px solid var(--border-soft);border-radius:10px;width:fit-content;max-width:100%}.tab{padding:7px 13px;border-radius:6px;color:var(--muted);font-size:12px;font-weight:650;text-decoration:none;transition:background .15s,color .15s}.tab:hover{color:var(--text);background:var(--card-2)}.tab.active{color:#07120d;background:var(--accent)}.tabs-on .panel{display:none}.tabs-on #panel-status{display:block}.tabs-on .panel.on{display:block}.tabs-on.hide-status #panel-status{display:none}.tabs-on #saveBar{display:none}.tabs-on.save-on #saveBar{display:flex}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin:0 2px 12px}.panel-head .band-lead{margin:0}.host-line{display:flex;align-items:stretch}.host-line input{border-top-right-radius:0;border-bottom-right-radius:0}.host-line input:focus{box-shadow:none}.host-suffix{display:flex;align-items:center;padding:0 12px;border:1px solid var(--border);border-left:0;border-radius:0 8px 8px 0;background:#0b1017;color:var(--muted);font-family:var(--mono);font-size:13px;white-space:nowrap}.host-line.solo input{border-radius:8px}.host-line.solo .host-suffix{display:none}.host-line:focus-within input,.host-line:focus-within .host-suffix{border-color:var(--accent)}.host-line:focus-within{box-shadow:0 0 0 3px rgba(61,220,151,.15);border-radius:8px}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0 0 16px}@media(min-width:760px){.metrics{grid-template-columns:repeat(4,minmax(0,1fr))}}.metric{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;box-shadow:inset 0 1px 0 rgba(255,255,255,.03)}.metric span{display:block;color:var(--dim);font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;margin-bottom:6px}.metric strong{font:600 16px var(--mono);color:var(--text)}.diag-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:16px}@media(min-width:760px){.diag-grid{grid-template-columns:minmax(0,1.65fr) minmax(260px,.7fr)}}.actions{display:flex;flex-wrap:wrap;gap:8px}.btn-danger{color:#ff9ca5;border-color:rgba(255,92,106,.45);background:transparent}.btn-danger:hover{background:rgba(255,92,106,.08)}#log{height:360px;margin:0;padding:14px;overflow:auto;background:#070b10;border:1px solid var(--border-soft);border-radius:8px;color:#b9c8d9;font:11px/1.55 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}.shot{aspect-ratio:5/3;border:1px solid var(--border-soft);border-radius:9px;margin-bottom:13px;background:linear-gradient(135deg,#0c131c,#152335);display:flex;align-items:center;justify-content:center;color:var(--dim);font:12px var(--mono);text-align:center;padding:20px}.note{color:var(--muted);font-size:11px;line-height:1.5;margin:10px 0 0}.banner-warn{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 18px;margin-bottom:26px;border-radius:11px;background:linear-gradient(90deg,rgba(255,92,106,.14),rgba(255,180,67,.08));border:1px solid rgba(255,92,106,.4);color:#ffd5d9;font-size:13px}.banner-warn strong{color:#fff;font-weight:650}.grid-2{display:grid;grid-template-columns:1fr;gap:16px;margin-bottom:18px}@media(min-width:760px){.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}}.row-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px 22px;box-shadow:inset 0 1px 0 rgba(255,255,255,.03),0 8px 24px rgba(0,0,0,.25)}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border-soft)}.card-eyebrow{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);margin-bottom:3px;display:block}.card-title{margin:0;font-size:16px;font-weight:650;color:var(--text);letter-spacing:-.01em}.card-desc{margin:3px 0 0;font-size:12px;color:var(--muted)}.card-badge{font-family:var(--mono);font-size:11px;font-weight:600;padding:3px 9px;border-radius:6px;background:var(--card-2);border:1px solid var(--border);color:var(--muted);white-space:nowrap}.card-badge.live{background:var(--accent-soft);border-color:rgba(61,220,151,.35);color:var(--accent)}.field{margin-bottom:13px}.field:last-child{margin-bottom:0}.field-label{display:block;font-size:12px;font-weight:600;color:#c7d2e0;margin-bottom:5px}.field-hint{display:block;font-size:11px;color:var(--dim);margin-top:4px}input[type='text'],input[type='password'],input[type='number'],select{width:100%;padding:9px 12px;background:#0b1017;color:var(--text);border:1px solid var(--border);border-radius:8px;font-size:13px;font-family:inherit;transition:border-color .15s,box-shadow .15s;outline:none}select{appearance:auto;cursor:pointer}input[type='number']{font-family:var(--mono);font-variant-numeric:tabular-nums}input:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(61,220,151,.15)}.host-line input[type='text']{width:auto;flex:1;min-width:0}input::placeholder{color:var(--dim)}.toggle-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:11px 13px;margin-top:6px;background:#0b1017;border:1px solid var(--border-soft);border-radius:9px;cursor:pointer;user-select:none;transition:border-color .15s}.toggle-row:hover{border-color:var(--border)}.toggle-copy{display:flex;flex-direction:column;gap:2px}.toggle-title{font-size:13px;font-weight:600;color:var(--text)}.toggle-sub{font-size:11px;color:var(--muted)}.toggle-input{position:absolute;opacity:0;width:0;height:0}.toggle-track{position:relative;flex-shrink:0;width:40px;height:22px;background:#1c2635;border:1px solid var(--border);border-radius:999px;transition:background .2s,border-color .2s}.toggle-thumb{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#8a99ad;transition:transform .2s,background .2s}.toggle-input:checked+.toggle-track{background:rgba(61,220,151,.22);border-color:var(--accent)}.toggle-input:checked+.toggle-track .toggle-thumb{transform:translateX(18px);background:var(--accent)}.printer-list{display:flex;flex-direction:column;gap:8px}.printer-item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 13px;background:#0b1017;border:1px solid var(--border);border-radius:9px;cursor:pointer;transition:border-color .15s,background .15s}.printer-item:hover{border-color:#344863;background:#0e151f}.printer-item.active{border-color:var(--accent);background:rgba(61,220,151,.07)}.printer-left{display:flex;align-items:center;gap:10px;min-width:0}.printer-left input[type='radio']{accent-color:var(--accent);width:16px;height:16px;margin:0;cursor:pointer}.printer-name{font-weight:600;color:var(--text);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.printer-model{font-family:var(--mono);font-size:11px;color:var(--muted);padding:2px 7px;background:var(--card-2);border:1px solid var(--border-soft);border-radius:5px}.empty-note{padding:16px;background:#0b1017;border:1px dashed var(--border);border-radius:9px;color:var(--muted);font-size:13px;text-align:center}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 18px;border-radius:8px;font-size:13px;font-weight:650;font-family:inherit;cursor:pointer;border:1px solid transparent;text-decoration:none;transition:all .15s}.btn-primary{background:var(--accent);color:#06120c;border-color:var(--accent)}.btn-primary:hover{background:var(--accent-hover);box-shadow:0 4px 16px rgba(61,220,151,.28)}.btn-secondary{background:var(--card-2);color:var(--text);border-color:var(--border)}.btn-secondary:hover{background:#1c293b;border-color:#354a66}.btn-block{width:100%}.ota-actions{display:flex;flex-direction:column;gap:10px;margin-top:8px}.ota-meta{display:flex;align-items:center;justify-content:space-between;padding:10px 13px;background:#0b1017;border:1px solid var(--border-soft);border-radius:9px;margin-bottom:10px}.ota-ver{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--text)}.fw-rows{margin-bottom:12px}.fw-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 2px;border-bottom:1px solid var(--border-soft);font-size:13px}.fw-row:last-child{border-bottom:0}.fw-row .k{color:var(--muted)}.fw-row .v{color:var(--text);text-align:right;font-variant-numeric:tabular-nums}.fw-row .v.mono{font-family:var(--mono);font-weight:600}.fw-row .v.new{color:var(--accent)}.band{margin:0 0 30px}.band-kicker{display:flex;align-items:center;gap:12px;margin:0 2px 8px}.band-kicker h2{margin:0;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#9aabbe;white-space:nowrap}.band-kicker .card-badge{flex:none}#f_otaPass{scroll-margin-top:28px}.band-rule{flex:1;height:1px;min-width:16px;background:linear-gradient(90deg,#314158,transparent)}.band-lead{margin:0 2px 12px;max-width:68ch;color:var(--muted);font-size:13px;line-height:1.45}.band .grid-2{margin-bottom:0}.card.thread{box-shadow:inset 0 2px 0 rgba(61,220,151,.9),inset 0 1px 0 rgba(255,255,255,.03),0 8px 24px rgba(0,0,0,.25)}.fw-split{display:grid;grid-template-columns:1fr;gap:16px}.split-2{display:grid;grid-template-columns:1fr}@media(min-width:760px){.fw-split{grid-template-columns:minmax(0,1.15fr) minmax(268px,.85fr);align-items:start;gap:22px}.split-2{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}.card>.btn{margin-top:14px}.fw-side{display:flex;flex-direction:column;gap:8px;padding:14px;background:#0b1017;border:1px solid var(--border-soft);border-radius:10px}.fw-side .toggle-row{margin-top:0;background:#111823}.subhead{margin:14px 0 8px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--dim)}.group .subhead:first-child,.fw-side>.subhead{margin-top:0}.split-2 .group+.group{padding-top:16px;border-top:1px solid var(--border-soft)}@media(min-width:760px){.split-2 .group+.group{padding:0 0 0 26px;border-top:0;border-left:1px solid var(--border-soft)}}.install{display:flex;flex-direction:column;gap:8px;margin-top:4px;padding-top:12px;border-top:1px solid var(--border-soft)}.install .subhead{margin-top:0}.install form{margin:0}.after-split{margin-top:16px;padding-top:16px;border-top:1px solid var(--border-soft)}.after-split .subhead{margin-top:0}.after-split .field{max-width:480px}.group-lead{margin:-4px 0 12px;font-size:12px;color:var(--muted)}.seg{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:6px}.seg label{position:relative;cursor:pointer}.seg input{position:absolute;opacity:0;width:0;height:0;margin:0}.seg span{display:block;padding:9px 4px;text-align:center;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--text);background:var(--bg-elev);border:1px solid var(--border);border-radius:8px;transition:background .15s,border-color .15s,color .15s}.seg label:hover span{border-color:#30425a}.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:#07120d}.seg input:focus-visible+span{box-shadow:0 0 0 3px rgba(61,220,151,.25)}.seg input:disabled+span{color:var(--dim);background:transparent;border-style:dashed;cursor:not-allowed}.group,.fw-split>div{min-width:0}.fw-notes-btns{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}.btn-quiet{background:transparent;color:var(--muted);border-color:var(--border);padding:7px 13px;font-size:12px}.btn-quiet:hover:not(:disabled){color:var(--text);border-color:#354a66}.btn-quiet:disabled{opacity:.45;cursor:default}.notes{display:none;max-height:300px;overflow:auto;margin:0 0 12px;padding:12px 14px;background:#0b1017;border:1px solid var(--border-soft);border-radius:9px;color:#b9c8d9;font:12px/1.55 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}.save-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;padding:16px 22px;margin-top:4px;background:rgba(17,24,35,.92);border:1px solid var(--border);border-radius:13px;box-shadow:0 12px 32px rgba(0,0,0,.4)}.save-copy{font-size:13px;color:var(--muted)}.save-copy strong{color:var(--text);font-weight:600}</style><script>document.documentElement.classList.add('tabs-on')</script></head><body><div class='shell'>␀<header class='topbar'><div class='brand'><div class='swatch-mark'><span class='sm-1'></span><span class='sm-2'></span><span class='sm-3'></span><span class='sm-4'></span></div><div><h1 class='brand-title'>Digital Swatch System</h1><p class='brand-sub'>Guition JC4880P443C 4.3-inch Hardware Configuration Console</p></div></div><div class='telemetry'><span class='chip'><span class='dot'></span><strong>␀</strong></span><span class='chip'>FW <strong>v␀</strong></span><span class='chip'>IP <strong>␀␀</strong></span><span class='chip'>HEAP <strong>␀␀␀␀ KB</strong></span></div></header><nav class='tabs' aria-label='Console sections'><a class='tab active' href='#panel-status'>Status</a><a class='tab' href='#panel-firmware'>Firmware</a><a class='tab' href='#panel-data'>Data</a><a class='tab' href='#panel-network'>Network</a><a class='tab' href='#panel-display'>Display</a></nav>␀␀␀<div class='banner-warn'><div><strong>Unprotected Console:</strong> No admin/OTA password is set. Anyone on your local network can modify settings or flash firmware.</div><a href='#panel-network' class='btn btn-secondary' data-focus='f_otaPass' style='padding:6px 12px;font-size:12px'>Set Password</a></div>␀<section id='panel-firmware' class='panel'><div class='panel-head'><p class='band-lead'>The version on this panel, whether it should look for a newer one, and how to install an update.</p>␀␀␀␀<span class='card-badge'>OTA Ready</span>␀␀␀<span class='card-badge live'>NEW v␀</div><div class='card thread'><div class='fw-split'><div>␀␀<div class='fw-rows'><div class='fw-row'><span class='k'>Installed</span><span class='v mono'>v␀</span></div><div class='fw-row'><span class='k'>Channel</span><span class='v' id='fwch'>&hellip;</span></div><div class='fw-row'><span class='k'>Released</span><span class='v' id='fwrel'>&hellip;</span></div><div class='fw-row'><span class='k'>Installed on</span><span class='v' id='fwsince' data-t='␀␀␀'>&hellip;</span></div><div class='fw-row'><span class='k'>Latest on GitHub</span><span class='v mono␀␀␀ new␀␀␀␀' id='ghlat'>␀␀␀&hellip;␀␀␀␀</span></div><div class='fw-row'><span class='k'>Latest released</span><span class='v' id='ghrel'>&hellip;</span></div></div><div class='fw-notes-btns'><button type='button' class='btn btn-quiet' id='fwnb' disabled>Release notes</button><button type='button' class='btn btn-quiet' id='ghnb' disabled>What's new</button></div><pre class='notes' id='fwn'></pre><pre class='notes' id='ghn'></pre><p class='field-hint' style='margin:0'>Release details are read from GitHub by this browser.</p></div><div class='fw-side'><p class='subhead'>Update checks</p>␀␀␀␀Check GitHub Releases hourly and show an update badge on the display menu␀␀␀Automatically Check for Firmware Updates␀␀␀␀Also offer GitHub pre-releases. Betas are for testing and may have bugs; the web flasher only ever installs stable releases␀Include Beta Releases␀␀␀<p class='field-hint'>Saved with the configuration at the bottom of this page.</p><div class='install'><p class='subhead'>Install</p><form method='POST' action='/github-update'><button class='btn btn-primary btn-block' type='submit'>Check &amp; Install Latest Release from GitHub</button></form><a class='btn btn-secondary btn-block' href='/update'>Upload Local .bin Firmware Over Wi-Fi</a></div></div></div></div></section>␀␀␀␀<section id='panel-status' class='panel'><div class='panel-head'><p class='band-lead'>Which printer the swatches follow, and how this panel is running.</p></div><section class='metrics'><div class='metric'><span>Uptime</span><strong>␀␀␀</strong></div><div class='metric'><span>Free Heap</span><strong>␀␀␀ KB␀</strong></div><div class='metric'><span>Free PSRAM</span><strong>␀␀</strong></div><div class='metric'><span>Wi-Fi RSSI</span><strong>␀␀</strong></div><div class='metric'><span>IP Address</span><strong>␀␀</strong></div><div class='metric'><span>Data Source</span><strong>␀</strong></div><div class='metric'><span>Min Free Heap</span><strong>␀␀␀</strong></div><div class='metric'><span>Update Status</span><strong>␀␀␀Available␀␀␀Current␀</strong></div></section>␀␀␀<form class='card' method='POST' action='/printer'>␀<div class='empty-note'>␀␀␀␀<div class='printer-list'>␀␀<label class='printer-item␀␀ active␀'><div class='printer-left'><input type='radio' name='pid' value='␀␀><span class='printer-name'>␀␀␀␀</span></div><div style='display:flex;align-items:center;gap:6px'>␀␀<span class='printer-model'>␀␀␀␀<span class='card-badge live'>ACTIVE</span>␀</div></label>␀␀</div><button class='btn btn-primary btn-block' type='submit'>Switch Monitored Printer</button></form>␀␀<div class='diag-grid'><section class='card'><div class='card-head'><div><h3 class='card-title'>Firmware log</h3><p class='card-desc'>Connection, polling, update, and recovery events from this boot.</p></div><div class='actions'><button type='button' class='btn btn-secondary' id='pause'>Pause</button><button type='button' class='btn btn-danger' id='clear'>Clear</button></div></div><pre id='log'>Loading log...</pre></section><aside class='card'><div class='card-head'><div><h3 class='card-title'>Display screenshot</h3><p class='card-desc'>Capture the current 800 x 480 framebuffer.</p></div></div><div class='shot'>RGB565 framebuffer<br>800 x 480</div><a class='btn btn-primary btn-block' href='/screenshot.png' download='filaman-display.png'>Download Current Screenshot</a><p class='note'>The image is the screen on the panel right now. Encoding it as a PNG can take a few seconds.</p></aside></div></section>␀␀<form id='cfg' method='POST' action='/save'>␀␀␀␀<div id='panel-data' class='panel'><div class='panel-head'><p class='band-lead'>FilaMan is used when a URL is set. Otherwise the panel listens on MQTT.</p></div><div class='grid-2'>␀␀␀<div class='card'><div class='card-head'><div><h3 class='card-title'>FilaMan</h3><p class='card-desc'>HTTP or HTTPS polling of the spool inventory.</p></div><span class='card-badge␀␀␀␀ live␀␀␀</span></div>␀␀␀http://192.168.1.50:8000␀␀␀␀Example: http://192.168.1.50:8000 (leave blank to use MQTT only)␀␀␀␀text␀␀␀␀FilaMan Base URL␀␀␀␀Bearer token for the FilaMan Display API␀␀␀␀FilaMan API Key␀Skip certificate verification when connecting to FilaMan over local HTTPS␀␀␀Allow Self-Signed LAN TLS␀␀␀<div class='card'><div class='card-head'><div><h3 class='card-title'>MQTT</h3><p class='card-desc'>Broker, account, and the topic this panel subscribes to.</p></div></div>␀<div class='row-2'>␀192.168.1.10␀␀␀␀MQTT Broker Host␀␀␀␀number␀␀MQTT Port␀␀␀</div><div class='row-2'>␀␀␀MQTT Username␀␀␀MQTT Password␀␀␀Base topic subscribed by the panel (e.g. filaman/display)␀␀␀MQTT Topic Prefix␀␀␀</div></div></div>␀␀<div id='panel-network' class='panel'><div class='panel-head'><p class='band-lead'>Wi-Fi, the name on your network, the clock, and the password for this console.</p></div><div class='card'><div class='split-2'><div class='group'><p class='subhead'>Wireless</p>␀␀␀␀Wi-Fi SSID (2.4 GHz)␀␀␀␀Wi-Fi Password␀␀<p class='subhead'>Console access</p>␀␀␀Protects this web console (user: admin) and wireless OTA flashing␀␀␀Admin / OTA Password␀␀␀␀</div><div class='group'><p class='subhead'>Name and clock</p>␀␀.local␀␀The name your router shows, and the wireless update target. Clear it to restore the default.␀␀␀␀<br>Reachable at: ␀␀.local/ &middot; ␀␀␀<div class='field'><label class='field-label' for='f_otaHost'>Device Hostname</label><div class='host-line␀␀ solo␀␀␀' id='hostLine'␀ data-ip='␀␀><input id='f_otaHost' type='text' name='otaHost' value='␀␀␀'><span class='host-suffix'>.local</span></div><span class='field-hint' id='hostHint'>␀␀Finds the panel by name with no DNS server involved. Turn off if your network should carry no .local traffic; wireless updates then use the IP.␀Answer to .local on the local network (mDNS)␀␀␀␀<div class='field'><label class='field-label' for='f_tzPreset'>Time zone</label><select id='f_tzPreset' name='tzPreset'>␀␀␀␀<option value='' selected>Keep current setting</option>␀<option value='␀ selected␀␀␀</option>␀␀␀</select><span class='field-hint'>Pick the place nearest you. Daylight saving is handled automatically.</span></div>␀␀␀␀</div></div></div></div>␀␀␀␀<div id='panel-display' class='panel'><div class='panel-head'><p class='band-lead'>Backlight, sleep timers, navigation, spool alerts, and orientation &mdash; the same choices as Display &amp; Alerts on the panel.</p></div><div class='card'><div class='split-2'><div class='group'><p class='subhead'>Backlight</p><p class='group-lead'>Brightness while awake and when the panel soft-dims.</p>␀␀</div><div class='group'><p class='subhead'>Sleep timers</p><p class='group-lead'>Dim first, then blank the panel, or leave it dimmed.</p>␀␀</div></div><div class='split-2 after-split'><div class='group'><p class='subhead'>Navigation</p><p class='group-lead'>Return to AMS View when you walk away from other screens.</p>␀␀␀␀</div><div class='group'><p class='subhead'>Spool alerts</p><p class='group-lead'>Remaining filament thresholds for amber warning and red critical.</p>␀</div></div><div class='after-split'><p class='subhead'>Orientation</p>␀Turns the picture and touch around if the panel is mounted upside down.␀Flip the screen 180&deg;␀␀␀␀<div class='save-bar' id='saveBar'><div class='save-copy'><strong>Apply configuration</strong> &mdash; Saves every setting on this page, including the firmware update checks, then reboots the display.</div><button class='btn btn-primary' type='submit' style='min-width:210px'>Save Configuration &amp; Reboot</button></div></form>␀␀␀<style>.links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}.links a{display:flex;align-items:center;justify-content:center;gap:8px;padding:11px 8px;border-radius:9px;text-decoration:none;font-size:13px;font-weight:600;background:#111823;color:#c7d2e0;border:1px solid #222f42;transition:background .14s}.links a:hover{background:#18222f}.links svg{width:15px;height:15px;flex:none;fill:currentColor}</style><footer class='links'><a href='https://github.com/wolfrage76/Filaman-Digital-Swatches' target='_blank' rel='noopener'><svg viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0024 12.5C24 5.87 18.63.5 12 .5z'/></svg>GitHub</a><a href='https://makerworld.com/en/@Wofl' target='_blank' rel='noopener'><svg viewBox='0 0 24 24' aria-hidden='true' focusable='false'><path d='M12 2.5l8.5 4.75v9.5L12 21.5l-8.5-4.75v-9.5L12 2.5zm0 2.29L6.06 8.1 12 11.4l5.94-3.3L12 4.79zM5.5 9.79v5.79l5.5 3.07v-5.79L5.5 9.79zm13 0l-5.5 3.07v5.79l5.5-3.07V9.79z'/></svg>MakerWorld</a></footer>␀␀␀<script>const REPO='wolfrage76/Filaman-Digital-Swatches',INST='␀',BETA=␀
const $=id=>document.getElementById(id);
function day(s){return s?new Date(s).toLocaleDateString():'-';}
function cmp(a,b){const p=v=>{v=v.replace(/^v/,'');const i=v.indexOf('-');
return[v.slice(0,i<0?v.length:i).split('.').map(Number),i<0?'':v.slice(i+1)];};
const[x,xs]=p(a),[y,ys]=p(b);for(let i=0;i<3;i++){const d=(x[i]||0)-(y[i]||0);if(d)return d;}
if(xs===ys)return 0;if(!xs)return 1;if(!ys)return -1;
return xs.localeCompare(ys,undefined,{numeric:true});}
function gh(path){return fetch('https://api.github.com/repos/'+REPO+path,
{headers:{Accept:'application/vnd.github+json'}}).then(r=>r.ok?r.json():Promise.reject(r.status));}
function notes(btn,pre,shown,text){const b=$(btn),p=$(pre);b.disabled=!text;
b.onclick=()=>{const open=p.style.display==='block';p.textContent=text;
p.style.display=open?'none':'block';b.textContent=open?shown:'Hide';};}
(function(){const e=$('fwsince'),t=parseInt(e.dataset.t||'0');
e.textContent=t?new Date(t*1000).toLocaleString():'Waiting for network time';})();
gh('/releases/tags/v'+INST).then(d=>{$('fwch').textContent=d.prerelease?'Pre-release':'Release';
$('fwrel').textContent=day(d.published_at);notes('fwnb','fwn','Release notes',d.body||'');})
.catch(s=>{$('fwch').textContent=s===404?'Local build':'Unknown';$('fwrel').textContent='-';});
(BETA?gh('/releases?per_page=5').then(l=>l.filter(r=>!r.draft)
.reduce((a,r)=>!a||cmp(r.tag_name,a.tag_name)>0?r:a,null)||Promise.reject(404))
:gh('/releases/latest')).then(d=>{const l=$('ghlat');l.textContent=d.tag_name;
const newer=cmp(d.tag_name,INST)>0;l.classList.toggle('new',newer);
$('ghrel').textContent=day(d.published_at);
if(newer)notes('ghnb','ghn',"What's new",d.body||'');})
.catch(()=>{$('ghrel').textContent='-';});
document.querySelectorAll('a[href^="#panel-"]').forEach(a=>{
 a.addEventListener('click',e=>{
  const id=a.getAttribute('href').slice(1);
  if(!$(id))return;
  e.preventDefault();
  show(id,true);
  if(a.dataset.focus){const f=$(a.dataset.focus);if(f)f.focus();}
 });
});
function show(id,push){
 document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('on',p.id===id));
 const settings=id!=='panel-status';
 document.documentElement.classList.toggle('hide-status',settings);
 document.documentElement.classList.toggle('save-on',settings);
 document.querySelectorAll('nav .tab').forEach(t=>t.classList.toggle('active',t.getAttribute('href')==='#'+id));
 if(push)history.replaceState(null,'','#'+id);
}
const start=(location.hash||'#panel-status').slice(1);
if($(start))show(start,false);
const hostLine=$('hostLine'),hostHint=$('hostHint');
function syncHost(){
 const on=$('f_mdns').checked;
 hostLine.classList.toggle('solo',!on);
 const name=($('f_otaHost').value||'').trim();
 const ip=hostLine.dataset.ip||'';
 let t='The name your router shows, and the wireless update target. Clear it to restore the default.';
 if(ip){t+=' Reachable at: ';if(on&&name)t+='http://'+name+'.local/ В· ';t+='http://'+ip+'/';}
 hostHint.textContent=t;
}
$('f_mdns').addEventListener('change',syncHost);
$('f_otaHost').addEventListener('input',syncHost);
syncHost();
const TO=[5,10,15,30];
function syncTimers(e){
 const pick=n=>document.querySelector('input[name='+n+']:checked');
 const d=pick('dimMin'),o=pick('offMin');
 if(d&&o&&+o.value!==0&&+d.value>=+o.value){
  if(e&&e.target.name==='offMin'){const v=TO.filter(x=>x<+o.value).pop();
   document.querySelector('input[name=dimMin][value="'+v+'"]').checked=true;}
  else{const v=TO.find(x=>x>+d.value);
   document.querySelector('input[name=offMin][value="'+(v==null?0:v)+'"]').checked=true;}
 }
 document.querySelectorAll('input[name=dimMin]').forEach(i=>i.disabled=false);
 document.querySelectorAll('input[name=offMin]').forEach(i=>i.disabled=+i.value!==0&&+i.value<=TO[0]);
}
document.querySelectorAll('input[name=dimMin],input[name=offMin]').forEach(i=>i.addEventListener('change',syncTimers));
syncTimers();
let paused=false;
const log=$('log');
async function loadLog(){
 if(paused||document.documentElement.classList.contains('hide-status'))return;
 try{const r=await fetch('/diagnostics/logs',{cache:'no-store'});
  if(!r.ok)return;
  const atBottom=log.scrollTop+log.clientHeight>=log.scrollHeight-24;
  log.textContent=await r.text();
  if(atBottom)log.scrollTop=log.scrollHeight;
 }catch(e){}
}
$('pause').onclick=()=>{paused=!paused;$('pause').textContent=paused?'Resume':'Pause';};
$('clear').onclick=async()=>{await fetch('/diagnostics/logs',{method:'DELETE'});
 paused=false;$('pause').textContent='Pause';loadLog();};
loadLog();setInterval(loadLog,2500);
</script></div></body></html>␀␀␀tzPreset␀␀␀␀Rebooting Display...␀␀␀␀Your settings have been written to non-volatile storage. The panel will reconnect in a few seconds.␀Configuration Saved␀/save␀␀␀/github-update␀␀/diagnostics␀␀␀␀/diagnostics/logs␀␀␀/screenshot.png␀/screenshot.bmp␀/update␀Web screenshot capture completed␀␀␀␀Web screenshot capture send failed␀␀Display framebuffer unavailable␀Not enough memory for PNG encode␀␀␀␀Web screenshot capture started␀␀IHDR␀␀␀␀PNG encode init failed (tdefl=%d)␀␀␀IEND␀␀␀␀Web screenshot capture failed (ok=%d len=%u)␀␀␀␀PNG encode failed␀␀␀attachment; filename=filaman-display.png␀␀␀␀image/png␀␀␀‰PNG
